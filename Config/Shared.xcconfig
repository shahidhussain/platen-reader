// Build settings that must be the same for the Mac and iOS apps.
//
// Both app targets build on this file (it is the project-level base
// configuration), so the version, bundle ID and minimum OS versions are set
// in one place and the two apps cannot drift apart. Settings that differ by
// platform stay on each target in Xcode.
//
// The release workflow overrides MARKETING_VERSION and CURRENT_PROJECT_VERSION
// on the xcodebuild command line, which takes precedence over this file.

// One bundle ID for Mac and iOS: one App Store listing (universal purchase).
// The direct-download Mac build keeps it too.
PRODUCT_BUNDLE_IDENTIFIER = org.platenreader.PlatenReader
PRODUCT_NAME = Platen Reader
PRODUCT_MODULE_NAME = PlatenReader

// The version. 1.0.0 (27 Nov 2026) is the launch (the spec's "Decisions
// made"): the iOS app on the App Store, then the Mac app as a DMG with
// Sparkle. Before it, 0.1 was the first Mac release (M1, November 2026) and
// 0.8.x the run-up (0.8.1 to 0.8.79; build 0.8.79 went to TestFlight only).
// Bump the second number for each release with something new. Meanwhile the
// third number goes up by one with every change made (each request's
// commit), so a build on a test device can be matched to it; gaps between
// the versions that reach the App Store are fine.
MARKETING_VERSION = 1.0.8
// The build number. Every upload to App Store Connect needs a higher one
// than the last upload for that platform, so it is never set by hand here:
// - iOS, uploaded from Xcode (Product > Archive, then Distribute App): leave
//   "Manage Version and Build Number" ticked, and Xcode gives the upload the
//   next number App Store Connect expects.
// - Any upload from a script or workflow: pass the number of commits on main,
//   CURRENT_PROJECT_VERSION=$(git rev-list --count HEAD), which only goes up
//   and can be worked out again from the tag.
// - The Mac download build (release.yml) passes the workflow's run number.
// iOS and Mac builds are numbered separately, so the two schemes never clash.
CURRENT_PROJECT_VERSION = 1

// The minimum systems from the spec's "Decisions made".
MACOSX_DEPLOYMENT_TARGET = 14.0
IPHONEOS_DEPLOYMENT_TARGET = 17.0

SWIFT_VERSION = 5.0

// The app's accent: a bright warm orange, the icon's honey turned up into
// a design statement (light #F0861A, dark #FF9F0A, iOS's own dark orange).
// Defined once, in PlatenReader/Shared/Colours.xcassets ("Accent"), which
// both apps include. Code that must use it whatever the Mac's own accent
// colour is uses `Color.platenAccent`.
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = Accent

// Your own signing team, for running the iOS app on a real iPhone or iPad.
// It is personal, so it is kept out of the repository: create
// Config/Local.xcconfig (git-ignored) containing one line,
//   DEVELOPMENT_TEAM[sdk=iphone*] = <your team ID>
// The "?" means the file may be missing (CI and the Simulator need no team).
#include? "Local.xcconfig"
